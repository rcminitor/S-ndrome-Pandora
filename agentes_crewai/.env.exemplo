# Copie para .env NESTA pasta e preencha. O .env não vai para o GitHub.
# Formato do modelo: provedor/modelo (padrão do LiteLLM usado pelo CrewAI).

# Modelo forte, só para o Tutor
MODELO_TUTOR=anthropic/claude-sonnet-5
# Modelo barato, para Examinador e Revisor
MODELO_BARATO=anthropic/claude-haiku-4-5-20251001

# Chave do provedor (fica só aqui, nunca em variável global)
LLM_API_KEY=

# Opcional: gateway local compatível com OpenAI (ex.: seu OmniRoute).
# Nesse caso use modelos no formato openai/<nome-do-combo>.
# LLM_BASE_URL=http://localhost:20128/v1
# MODELO_TUTOR=openai/gratuitos
# MODELO_BARATO=openai/gratuitos

# Tetos que controlam o gasto
CONTEXTO_MAX_CHARS=6000
MAX_CARTOES=5
MAX_TOKENS_TUTOR=900
MAX_TOKENS_BARATO=600

# ---- Leitor de artigos (leitor_artigos.py) ----
# Modelo que traduz (o barato traduz bem; troque se quiser mais qualidade)
MODELO_TRADUTOR=anthropic/claude-haiku-4-5-20251001
# Seu e-mail: as APIs Crossref/OpenAlex/Unpaywall pedem para identificar quem consulta
EMAIL_CONTATO=
# Onde salvar os PDFs de acesso aberto baixados (padrão: agentes_crewai\biblioteca)
# PASTA_ESTUDO=C:\Users\rcmin\OneDrive\Documents\Pos-Graduacao\Doutorado UFC\Síndrome de Pandora\PDF\A_classificar
MAX_DOWNLOADS=15
LOTE_CHARS=3500
MAX_TOKENS_TRADUTOR=2500

# ---- Painel local e orientador ----
# Pastas (padrão: dentro do cofre). Descomente só se quiser mudar.
# BIBLIOTECA=C:\Users\rcmin\OneDrive\Documents\Pos-Graduacao\Doutorado UFC\Síndrome de Pandora\Leitura
# ACERVO=C:\Users\rcmin\OneDrive\Documents\Pos-Graduacao\Doutorado UFC\Síndrome de Pandora\PDF
# TESE_DIR=C:\Users\rcmin\OneDrive\Documents\Pos-Graduacao\Doutorado UFC\Síndrome de Pandora\Notas\Tese
# Modelo do orientador (vazio = usa o MODELO_TUTOR)
MODELO_ORIENTADOR=
MAX_TOKENS_ORIENTADOR=700
HISTORICO_TROCAS=6
